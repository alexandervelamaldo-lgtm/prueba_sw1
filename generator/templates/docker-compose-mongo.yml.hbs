services:
  db:
    image: mongo:7
    # Sin container_name fijo: ver la nota equivalente en docker-compose.yml.hbs.
    # Un nombre fijo colisiona entre copias de carpeta del mismo diagrama.
    environment:
      MONGO_INITDB_DATABASE: {{{project.databaseName}}}
    ports:
      - "27017:27017"
    volumes:
      - db-data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  db-data:
