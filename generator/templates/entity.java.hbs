{{/each}}
{{#each entity.associations}}
{{#if owning}}
    @{{{kind}}}(fetch = FetchType.{{{fetch}}}{{#if cascade}}, cascade = {{{cascade}}}{{/if}}{{#if orphanRemoval}}, orphanRemoval = true{{/if}})
{{#if joinColumn}}
    @JoinColumn(name = "{{{joinColumn}}}"{{#unless nullable}}, nullable = false{{/unless}})
{{/if}}
{{#if joinTable}}
    @JoinTable(
        name = "{{{joinTable.name}}}",
        joinColumns = @JoinColumn(name = "{{{joinTable.joinColumn}}}"),
        inverseJoinColumns = @JoinColumn(name = "{{{joinTable.inverseJoinColumn}}}")
    )
{{/if}}
{{else}}
    @{{{kind}}}(mappedBy = "{{{mappedBy}}}", fetch = FetchType.{{{fetch}}}{{#if cascade}}, cascade = {{{cascade}}}{{/if}}{{#if orphanRemoval}}, orphanRemoval = true{{/if}})
{{/if}}
    private {{{javaType}}} {{{fieldName}}}{{#if collection}} = new HashSet<>(){{/if}};

{{/each}}
    public {{{entity.className}}}() {
        // Constructor sin argumentos requerido por JPA. Público, no protegido,
        // porque el mapeador vive en otro paquete y lo invoca directamente.
    }

{{#unless entity.superclass}}
    public {{{entity.identifier.javaType}}} {{{entity.identifier.getterName}}}() {
        return {{{entity.identifier.name}}};
    }

    public void {{{entity.identifier.setterName}}}({{{entity.identifier.javaType}}} {{{entity.identifier.name}}}) {
        this.{{{entity.identifier.name}}} = {{{entity.identifier.name}}};
    }

{{/unless}}
{{#each fields}}
    public {{{javaType}}} {{{getterName}}}() {
        return {{{name}}};
    }

    public void {{{setterName}}}({{{javaType}}} {{{name}}}) {
        this.{{{name}}} = {{{name}}};
    }

{{/each}}
{{#each entity.associations}}
    public {{{javaType}}} {{{getterName}}}() {
        return {{{fieldName}}};
    }

    public void {{{setterName}}}({{{javaType}}} {{{fieldName}}}) {
        this.{{{fieldName}}} = {{{fieldName}}};
    }

{{/each}}
{{#each interfaceMethods}}
    @Override
    public {{{signature}}} {
        throw new UnsupportedOperationException(
