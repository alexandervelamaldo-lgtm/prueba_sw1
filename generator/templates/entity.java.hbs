@Entity
{{#unless entity.superclass}}
@Table(name = "{{{entity.tableName}}}")
{{/unless}}
{{#if entity.superclass}}
{{#unless (eq entity.hierarchyStrategy "SINGLE_TABLE")}}
@Table(name = "{{{entity.tableName}}}")
{{/unless}}
{{#if (eq entity.hierarchyStrategy "JOINED")}}
@PrimaryKeyJoinColumn(name = "{{{entity.identifier.columnName}}}")
{{/if}}
{{/if}}
{{#if entity.inheritanceStrategy}}
@Inheritance(strategy = InheritanceType.{{{entity.inheritanceStrategy}}})
{{/if}}
{{#if entity.discriminatorColumn}}
@DiscriminatorColumn(name = "{{{entity.discriminatorColumn}}}")
{{/if}}
public {{#if entity.isAbstract}}abstract {{/if}}class {{{entity.className}}}{{#if entity.superclass}} extends {{{entity.superclass}}}{{/if}}{{#if hasInterfaces}} implements {{{interfaceList}}}{{/if}} {

{{#unless entity.superclass}}
