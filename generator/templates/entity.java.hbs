    }

{{/each}}
    @Override
    public boolean equals(Object other) {
        if (this == other) {
            return true;
        }
        if (!(other instanceof {{{entity.className}}})) {
            return false;
        }
        {{{entity.className}}} that = ({{{entity.className}}}) other;
        return {{{entity.identifier.getterName}}}() != null
            && Objects.equals({{{entity.identifier.getterName}}}(), that.{{{entity.identifier.getterName}}}());
    }

    @Override
    public int hashCode() {
        // Constante deliberada: el identificador es null antes de persistir y
        // cambiar el hash tras el INSERT rompería cualquier HashSet que ya
        // contenga la entidad.
        return getClass().hashCode();
    }
}
