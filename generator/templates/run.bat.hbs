@echo off
rem Script de arranque para Windows: levanta la base de datos y el backend con
rem un solo comando.
rem
rem setlocal acota las variables DB_* que se definen más abajo a la ejecución
rem de este script: no quedan pegadas en la consola del usuario.
setlocal
rem Crea C:\Temp si no existe: el JDK 17+ necesita una carpeta de sockets Unix
rem sin caracteres raros en la ruta. Sin esto obtienes:
rem   java.io.IOException: Unable to establish loopback connection
rem
if not exist "C:\Temp" mkdir "C:\Temp"
rem --wait no devuelve el control hasta que el healthcheck de "db" en
rem docker-compose.yml pasa a "healthy": evita arrancar Spring contra una base
rem de datos que todavía está inicializando.
docker compose up -d --wait
if errorlevel 1 exit /b 1
{{#if (eq project.databaseTarget 'postgres')}}
rem docker-compose.yml no fija el puerto del host (ver la nota ahí): deja que
rem el sistema operativo asigne uno libre, así ninguna instalación nativa de
rem Postgres puede interceptar las conexiones. El precio es que el puerto
rem cambia cada vez que se recrea el contenedor, de modo que hay que
rem preguntárselo a Docker en cada arranque en lugar de darlo por sabido.
set DB_PORT=
for /f "tokens=2 delims=:" %%p in ('docker compose port db 5432') do set DB_PORT=%%p
if not defined DB_PORT echo [ERROR] No se pudo averiguar el puerto que Docker publico para la base de datos. Revisa "docker compose ps".
if not defined DB_PORT goto fallo
rem Credenciales fijadas aquí a propósito, aunque application.yml ya traiga los
rem mismos valores por defecto: Spring da prioridad a las variables de entorno,
rem así que un DB_USER o DB_PASSWORD heredado del entorno de Windows —definido
rem hace meses para otra base— se colaría y provocaría un fallo de
rem autenticación contra este contenedor. Fijarlas aquí las deja siempre
rem alineadas con docker-compose.yml.
set DB_HOST=127.0.0.1
set DB_NAME={{{project.databaseName}}}
set DB_USER=postgres
set DB_PASSWORD=postgres
echo Base de datos "%DB_NAME%" en %DB_HOST%:%DB_PORT%
{{/if}}
rem El puerto de la API se comprueba ANTES de llamar a Maven. Si está ocupado,
rem Spring arranca, falla con "Port 8080 was already in use" y se muere; como
rem esta ventana se cierra con el script, el mensaje pasa volando y el síntoma
rem que queda es "aprieto run.bat y no hace nada". Vale la pena mirarlo aquí y
rem además decir qué programa lo tiene: en Windows el 8080 lo ocupan cosas
rem instaladas que nadie asocia a un backend (Steam, por ejemplo, lo usa para
rem su cliente web). Se respeta un SERVER_PORT que ya venga del entorno, para
rem poder esquivar el conflicto sin editar este archivo.
if not defined SERVER_PORT set SERVER_PORT=8080
netstat -ano | findstr /r /c:":%SERVER_PORT% .*LISTENING" >nul 2>&1
if not errorlevel 1 goto puerto_ocupado
echo API en http://localhost:%SERVER_PORT%
rem "call" no es opcional: mvn es un .cmd y, sin call, cmd.exe le transfiere el
rem control y no vuelve nunca, así que ni el salto a :fallo ni su "pause" se
rem ejecutarían y el error de Maven volvería a perderse al cerrarse la ventana.
call mvn spring-boot:run
if errorlevel 1 goto fallo
exit /b 0

:puerto_ocupado
echo.
echo [ERROR] El puerto %SERVER_PORT% ya esta ocupado. Lo tiene:
for /f "tokens=5" %%q in ('netstat -ano ^| findstr /r /c:":%SERVER_PORT% .*LISTENING"') do tasklist /fi "pid eq %%q" /nh
echo.
echo Cierra ese programa, o arranca en otro puerto con:
echo     set SERVER_PORT=8081 ^&^& run.bat
echo Si cambias el puerto, actualiza la variable "baseUrl" de la coleccion de Postman.
echo.
pause
exit /b 1

:fallo
echo.
echo [ERROR] El backend no arranco. El motivo esta en los mensajes de arriba.
echo.
rem La pista mas util que se puede dar sin leer el log: el volumen de Docker
rem sobrevive a "docker compose down" y su nombre sale de la carpeta, asi que
rem regenerar el proyecto en una carpeta con el mismo nombre reaprovecha la base
rem de datos de la generacion anterior. Si el esquema cambio, Flyway encuentra
rem su propio historial con otro checksum y se niega a seguir. El mensaje no
rem menciona Docker ni el volumen por ningun lado, de modo que conviene
rem nombrarlo aqui.
echo Si arriba dice "Migration checksum mismatch", "Validate failed" o "no
echo existe la base de datos", el volumen de Docker guarda la base de una
echo generacion anterior de este mismo proyecto. Para empezar de cero:
echo.
echo     docker compose down -v
echo     run.bat
echo.
echo Ojo: "down -v" borra los datos de esa base (el -v es justo lo que la
echo elimina; sin el, "down" la conserva y el error se repite).
echo.
pause
exit /b 1
